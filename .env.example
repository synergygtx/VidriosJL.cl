# ID de medicion de Google Analytics 4 (formato G-XXXXXXXXXX).
# Se obtiene en Analytics > Administrar > Flujos de datos > Flujo web.
# Si esta vacio, el sitio funciona igual pero no carga GA ni registra eventos.
NEXT_PUBLIC_GA_ID=

# ID de la cuenta de Google Ads (formato AW-XXXXXXXXXX).
# Se obtiene en Ads > Objetivos > Conversiones > la accion > Instalar la etiqueta.
# Si esta vacio, no se declara la cuenta de Ads y no se registran conversiones.
NEXT_PUBLIC_ADS_ID=

# Destino completo de la conversion, tal cual lo entrega Ads en `send_to`
# (formato AW-XXXXXXXXXX/EtiquetaDeLaConversion).
# Se guarda entero, no partido, para que el ID y la etiqueta no se desincronicen.
NEXT_PUBLIC_ADS_CONVERSION=
