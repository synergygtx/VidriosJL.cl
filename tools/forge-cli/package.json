{
  "name": "@getforja/forge",
  "version": "5.3.1",
  "description": "Multi-platform CLI for the Forge factory OS",
  "type": "module",
  "bin": {
    "forge": "./bin/forge.js"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:snapshot": "node --import tsx src/test/snapshot.ts",
    "postinstall": "node scripts/cleanup-legacy-alias.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "prompts": "^2.4.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "forge",
    "cli",
    "multi-platform",
    "ai",
    "agents",
    "claude",
    "codex",
    "opencode",
    "cursor",
    "gemini"
  ],
  "license": "MIT"
}
